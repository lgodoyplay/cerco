
# ==================== API ====================
# Use a full API base or a relative path to the proxy route.
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=http://localhost:3000

# ==================== WEBRTC (Optional) ====================
# STUN/TURN servers for voice calls
VITE_TURN_URL=stun:stun.l.google.com:19302
VITE_TURN_CRED=

# ==================== SUPABASE ====================
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==================== INTEGRATIONS (Optional) ====================
# For API-based reformulation of descriptions
VITE_OPENAI_API_KEY=your-openai-api-key

# For Discord webhook notifications
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
